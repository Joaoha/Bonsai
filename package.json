{
  "name": "bonsai-core-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Public monorepo for @bonsai/* packages: framework-agnostic Bonsai primitives and adapters.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages",
    "publint": "pnpm -r --filter \"./packages/*\" --if-present run publint",
    "attw": "pnpm -r --filter \"./packages/*\" --if-present run attw",
    "release:gate": "pnpm run build && pnpm run publint && pnpm run attw",
    "boundary:verify": "node scripts/verify-boundaries.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.5",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9",
    "globals": "^17.7.0",
    "publint": "^0.3.21",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0"
  }
}
