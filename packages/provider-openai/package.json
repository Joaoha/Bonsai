{
  "name": "@bonsai/provider-openai",
  "version": "0.0.0",
  "description": "OpenAI-compatible LLMProvider adapter for @bonsai/core (chat + streaming + tokenize).",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bonsai/core": "workspace:*"
  }
}
