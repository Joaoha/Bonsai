{
  "name": "@bonsai/storage-postgres",
  "version": "0.1.0",
  "description": "Postgres Storage adapter for @bonsai/core: migrations, repositories, FTS retriever.",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "prepublishOnly": "node -e \"console.error('Publishing @bonsai/* is disabled (BONA-247: packages are private).'); process.exit(1)\""
  },
  "dependencies": {
    "@bonsai/core": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "vitest": "^2.1.0"
  }
}
