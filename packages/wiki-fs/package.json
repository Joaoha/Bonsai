{
  "name": "@bonsai/wiki-fs",
  "version": "0.0.0",
  "description": "Markdown-on-disk WikiStore adapter for @bonsai/core (frontmatter, wikilinks, path-scoped writes).",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@bonsai/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "vitest": "^2.1.0"
  }
}
